# Oracle Cloud deployment — copy this to .env.oracle and fill in secrets
# NEVER commit .env.oracle to git

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=health_coach
POSTGRES_USER=health_user
POSTGRES_PASSWORD=replace_with_strong_password

# ── Spring Boot datasource (auto-set by compose, keep in sync with above) ─────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/health_coach
SPRING_DATASOURCE_USERNAME=health_user
SPRING_DATASOURCE_PASSWORD=replace_with_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=replace_with_very_long_random_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_MS=604800000

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=health_rabbit
RABBITMQ_PASS=replace_with_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_google_client_id

# ── GCS file storage (leave blank to use local uploads dir) ──────────────────
GCS_BUCKET_NAME=

# ── Field encryption key (AES-256-GCM, 32 bytes base64) ──────────────────────
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── DuckDNS (needed for deploy-oracle.sh to auto-update DNS) ─────────────────
# Find at: https://www.duckdns.org → your account token
DUCKDNS_TOKEN=replace_with_duckdns_token

# ── Groq (free tier: 14,400 req/day across all models) ───────────────────────
# Get key: https://console.groq.com → API Keys
# Models used: llama-3.3-70b-versatile (text), llama-3.2-11b-vision-preview (food/receipt images)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ── Anthropic Claude (optional — paid fallback for complex medical cases) ─────
# Get key: https://console.anthropic.com → API Keys
# Cost: $0.80/M input, $4.00/M output — only add if Gemini free tier is exhausted for REPORT tasks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Bhashini (Indian govt, 22 Indian languages — free for health/education) ──
# Register: https://bhashini.gov.in/ulca/search
# Used for: voice input → text, multilingual chat responses (Phase 2)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
