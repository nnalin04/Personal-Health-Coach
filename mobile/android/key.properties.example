## key.properties — EXAMPLE TEMPLATE
## Copy this to mobile/android/key.properties (never commit that file)
## key.properties is already in .gitignore

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=../upload-keystore.jks

## HOW TO GENERATE THE KEYSTORE
## Run this once from the mobile/android/ directory:
##
##   keytool -genkey -v \
##     -keystore upload-keystore.jks \
##     -alias upload \
##     -keyalg RSA \
##     -keysize 2048 \
##     -validity 10000
##
## Keep upload-keystore.jks in a secure location (password manager / backup).
## upload-keystore.jks is in .gitignore — never commit it.
##
## PLAY CONSOLE REGISTRATION
## After generating the keystore:
##   1. Go to Play Console → Setup → App signing
##   2. Upload your upload-keystore.jks as the upload key
##   3. Google manages the app signing key; you manage the upload key
