# OS
.DS_Store

# Claude AI configuration (local agent/skill definitions)
.claude/

# Env — all env files (only .env.*.tmpl and .env.example should be committed)
.env
.env.*
env.dev
env.uat
env.prod
env_vars
.keytool

# Python virtual environments
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Java build artifacts
backend/target/
backend/.mvn/
services/orchestrator/target/

# Flutter/Dart build artifacts
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/pubspec.lock
apps/flutter-legacy/build/
apps/flutter-legacy/.dart_tool/
apps/flutter-legacy/.flutter-plugins
apps/flutter-legacy/.flutter-plugins-dependencies

# React Native
apps/mobile-app/node_modules/

# Release APKs (distribute via GitHub Releases or direct transfer, not git)
releases/*.apk
releases/*.aab

# IDE
.vscode/
.idea/

# Android Signing (never commit keystores or key.properties with real passwords)
mobile/android/key.properties
mobile/android/app/keystores/
mobile/android/app/google-services.json
mobile/android/local.properties
apps/flutter-legacy/android/local.properties

# Debug/temp screenshots and UI dumps (emulator testing artifacts)
mobile/*.png
mobile/*.xml

# Design reference assets (large binary files, not source code)
stitch/
reference/

# E2E test scripts (may contain test credentials / generate QA accounts)
e2e_prod_test.py

# Local infrastructure & analysis docs (machine-specific, not for repo)
worker-node-setup.md
cost_and_pricing_analysis.md
scaling_to_one_million.md
test-reports/

# Oracle deployment secrets
.env.oracle
