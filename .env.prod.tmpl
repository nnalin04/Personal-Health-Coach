# Production environment variables
# Copy to .env.prod and fill all values before deployment.

# Database
POSTGRES_DB=health_coach_prod
POSTGRES_USER=health_user
POSTGRES_PASSWORD=generate_a_strong_db_password

# Spring Boot Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://health-coach-postgres:5432/health_coach_prod
SPRING_DATASOURCE_USERNAME=health_user
SPRING_DATASOURCE_PASSWORD=generate_a_strong_db_password

# Security Tokens
JWT_SECRET=generate_a_very_long_random_string_here
JWT_EXPIRATION_MS=86400000

# Google Auth & AI
GOOGLE_CLIENT_ID=your_google_web_client_id_from_console
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
